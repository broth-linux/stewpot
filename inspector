#!/bin/sh
# Broth Linux Upstream Expiration Checker

RECIPE_DIR="/usr/bin/recipes"

echo "[*] Checking expiration dates on pantry ingredients..."

for recipe in  "$RECIPE_DIR"/*.rsc; do
	[ -f "$recipe" ] || continue

	# Reset vars and source the recipe
	NAME=$(grep -E '^NAME=' "$recipe" | cut -d'=' -f2- | tr -d '"' | tr -d "'")
	VERSION=$(grep -E '^VERSION=' "$recipe" | cut -d'=' -f2- | tr -d '"' | tr -d "'")
	UPSTREAM_SOURCE=$(grep -E '^UPSTREAM_SOURCE=' "$recipe" | cut -d'=' -f2- | tr -d '"' | tr -d "'")


	# Skip recipes without an upstream git URL
	if [ -z "$UPSTREAM_SOURCE" ]; then
		continue
	fi

	echo -n "Checking $NAME (local: $VERSION)... "

		LATEST_VER=$(git ls-remote --tags --refs "$UPSTREAM_SOURCE" 2>/dev/null \
			| awk -F'/' '{print $NF}' \
			| grep -F -v '^{}' \
			| grep -v -i -E '(alpha|beta|rc|pre|dev|\.git|[0-9]{7,})' \
			| sed -E 's/^[a-zA-Z_-]*([0-9])/\1/; s/_/./g; s/-.*//' \
			| awk -v pkg="$NAME" -v v="$VERSION" '
				pkg == "libpng"			{ if ($0 ~ /^1\.6\.[0-9]+$/) print; next }
				pkg == "libwebp"		{ if ($0 ~ /^1\.[0-9]+(\.[0-9]+)*$/) print; next }
				pkg == "inih"			{ if ($0 ~ /^[0-9]+$/) print; next }
				pkg == "libjpeg-turbo"	{ if ($0 ~ /^[1-3]\.[0-9]+(\.[0-9]+)*$/) print; next }
				{ if ($0 ~ /^[0-9]+(\.[0-9]+)+$/) print }
			' | sort -V | tail -n1)


	
	if [ -z "$LATEST_VER" ]; then
		echo "UNKNOWN"
	elif [ "$LATEST_VER" = "$VERSION" ]; then
		echo "FRESH"
	elif [ "$(printf '%s\n%s\n' "$VERSION" "$LATEST_VER" | sort -V | tail -n1)" = "$LATEST_VER" ]; then
		echo "STALE -> Upstream is $LATEST_VER"
	else
		echo "FRESH (Ahead: $VERSION > $LATEST_VER)"
	fi
done





