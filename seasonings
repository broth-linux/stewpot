#!/bin/sh
# seasonings: Extract build toggles for Broth Linux flavors
# Usage: seasonings <source_directory> [flavor_mode]

set -eu

SRC_DIR="${1:-.}"
MODE="${2:-list}" # "list" (clean flags) or "flavor" (OPTION=default:desc format)

if [ ! -d "$SRC_DIR" ]; then
	printf '[-] Error: "%s" is not a directory.\n' "$SRC_DIR" >&2
	exit 1
fi

