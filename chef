#!/bin/sh
# Chef - Interactive kitchen interface for broth linux

COOKBOOK="/usr/bin/recipes"
INSTALLED="/var/db/stew/installed"
FLAVORS_DIR="/etc/broth/flavors"
CHEF_CONF="/etc/broth/chef.conf"


mkdir -p "$FLAVORS_DIR"

# Source persistent chef options if present
DEBUG_MODE="off"
if [ -f "$CHEF_CONF "]; then
	. "$CHEF_CONF"
fi


# Ensure dialog is availble
if ! command -v dialog >/dev/null 2>&1; then
	echo "Error: dialog is not installed." >&2
	exit 1
fi




# Options menu
options_menu() {
	while :; do
		TMP="/tmp/chef.$$"
		dialog --clear \
			--backtitle "Broth Linux - Kitchen Management" \
			--title " [ Kitchen Options and Settings ] " \
			--checklist "Toggle head chef features and debugging:" 12 55 3 \
			DEBUG "Enable autodepends (Dev Tools)" "$DEBUG_MODE" 2> "$TMP"
		STATUS=$?
		CHOICES=$(cat "$TMP")
		rm -f "$TMP"

		[ $STATUS -eq 1 ] || [ $STATUS -eq 255 ] && break

		if echo "$CHOICES" | grep -qw "DEBUG"; then
			DEBUG_MODE="on"
		else
			DEBUG_MODE="off"
		fi

		# Save configuration
		mkdir -p "$(dirname "$CHEF_CONF")"
		echo "DEBUG_MODE=\"$DEBUG_MODE\"" > "$CHEF_CONF"
		break
	done
}





# Main Menu
main_menu() {
	while :; do
	# Build main menu options
	ITEMS="1 \"Cook a recipe (Build & Install)\" \
		   2 \"Season food (Configure Flags)\" \
		   3 \"Inspect pantry (View installed)\" \
		   4 \"Spill a pot (Uninstall Package)\" \
		   5 \"Kitchen Options (Settings)\""

	if [ "$DEBUG_MODE" = "on" ]; then
		ITEMS="$ITEMS 6 \"Autodepends (Scan ELF Dependencies)\""
		ITEMS="$ITEMS 7 \"Exit the kitchen\""
		EXIT_KEY="7"
	else
		ITEMS="$ITEMS 6 \"Exit the kitchen\""
		EXIT_KEY="6"
	
	fi

	TMP="/tmp/chef.$$"
	eval "dialog --clear \
		--backtitle \"Broth Linux - Kitchen Management\" \
		--menu \"Select kitchen task:\" 18 55 8 $ITEMS" 2> "$TMP"
		ACTION=$(cat "$TMP")
		rm -f "$TMP"

		
		case "$ACTION" in
			"$EXIT_KEY"|"") clear; break ;;
			1) cook_menu ;;
			2) flavor_menu ;;
			3) inspect_menu ;;
			4) scrape_menu ;;
			5) options_menu ;;
			6)
				if [ "$DEBUG_MODE" = "on" ]; then
					autodepends_menu
				fi
				;;
		esac
	done
}





