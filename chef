# 4. Remove a package via scrape
scrape_menu() {
	PKGS=$(find "$INSTALLED" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; 2>/dev/null | sort)
	if [ -z "$PKGS" ]; then
		dialog --msgbox "No packages to scrape." 6 35
		return
	fi
	MENU_ITEMS=""
	for p in $PKGS; do
		MENU_ITEMS="$MENU_ITEMS $p $p"
	done

	TMP="/tmp/chef.$$"
	dialog --clear \
		--backtitle "Broth Linux - Chef" \
		--title " [ Scrape Pot ] " \
		--menu "Select package to purge:" 18 50 10 $MENU_ITEMS 2> "$TMP"
	PKG=$(cat "$TMP")
	rm -f "$TMP"
	[ -z "$PKG" ] && return

	dialog --yesno "Are you sure you want to scrape $PKG from the system?" 7 50
	if [ $? -eq 0 ]; then
		clear
		echo "Scraping $PKG..."
		spill "$PKG"
		printf "Press Enter to return to the kitchen..."
		read -r _
	fi
}



autodepends_menu() {
	PKGS=$(find "$INSTALLED" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; 2>/dev/null | sort)
	if [ -z "$PKGS" ]; then
		dialog --msgbox "The pantry is empty." 7 40
		return
	fi

	MENU_ITEMS=""
	for p in $PKGS; do
		MENU_ITEMS="$MENU_ITEMS $p $p"
	done

	TMP="/tmp/chef.$$"
	dialog --clear \
		--backtitle "Broth Linux - Chef Developer Tools" \
		--title " [ Inspect Dependencies (ELF) ] " \
		--menu "Select installed package to scan:" 18 50 10 $MENU_ITEMS 2> "$TMP"
	PKG=$(cat "$TMP")
	rm -f "$TMP"
	[ -z "$PKG" ] && return

	clear
	echo "====================================="
	echo " Scanning dependencies for: $PKG "
	echo "====================================="
	echo ""
	if command -v autodepends >/dev/null 2>&1; then
		autodepends "$PKG"
	elif [ -x "/home/spgit/autodepends" ]; then
		"/home/spgit/autodepends" "$PKG"
	else
		echo "[-] Error: autodepends script not found."
	fi
	echo ""
	printf "Press Enter to return to the kitchen..."
	read -r _
}

main_menu



